diff --git a/test/smart/state.test.cjs b/test/smart/state.test.cjs
new file mode 100644
index 0000000..008ed62
--- /dev/null
+++ b/test/smart/state.test.cjs
@@ -0,0 +1,177 @@
+const { test } = require("node:test");
+const assert = require("node:assert/strict");
+const { load } = require("./helpers.cjs");
+const id = { size: 10, modified: 1, digest: "old" };
+function state({ failJSON = false, changed = false } = {}) {
+  const files = new Map([
+    ["/doc.pdf", new Uint8Array([1])],
+    ["/data/storage/K/jasminum-outline.json", new Uint8Array([2])],
+  ]);
+  let current = { ...id },
+    writes = 0,
+    statCalls = 0;
+  const io = {
+    stat: async () => {
+      statCalls++;
+      return { size: current.size, lastModified: current.modified };
+    },
+    exists: async (p) => files.has(p),
+    makeDirectory: async () => {},
+    copy: async (a, b) => {
+      assert(!files.has(b));
+      files.set(b, files.get(a));
+    },
+    read: async (p) => files.get(p),
+    write: async (p, bytes) => {
+      files.set(p, bytes);
+      current = { ...id, modified: 3 };
+    },
+    remove: async (p) => files.delete(p),
+  };
+  const api = load(
+    "src/modules/outline/safeState.ts",
+    {
+      "./savePDF": {
+        writePDFOutline: async (item, nodes, expected) => {
+          assert.equal(expected.modified, 1);
+          writes++;
+          current = { size: 12, modified: 2, digest: "new" };
+          files.set("/doc.pdf", new Uint8Array([3]));
+        },
+      },
+      "./outline": {
+        saveOutlineToJSON: async () => {
+          if (failJSON) throw Error("disk full");
+        },
+      },
+    },
+    {
+      IOUtils: io,
+      PathUtils: {
+        join: (...s) => s.join("/").replace(/\/+/g, "/"),
+        parent: (p) => p.slice(0, p.lastIndexOf("/")),
+      },
+      Zotero: {
+        DataDirectory: { dir: "/data" },
+        Utilities: {
+          randomString: () => String(statCalls),
+          Internal: { md5Async: async () => current.digest },
+        },
+      },
+    },
+  );
+  return {
+    api,
+    files,
+    get writes() {
+      return writes;
+    },
+    item: { key: "K", getFilePathAsync: async () => "/doc.pdf" },
+    change: () => (current = { ...id, digest: "external" }),
+  };
+}
+test("保存前PDF内容改变，即使大小与mtime相同也拒绝且不写入", async () => {
+  const s = state();
+  s.change();
+  await assert.rejects(s.api.safeSaveOutline(s.item, [], id), /已改变/);
+  assert.equal(s.writes, 0);
+});
+test("保存成功备份PDF及旧sidecar，保留多代备份", async () => {
+  const s = state();
+  await s.api.safeSaveOutline(s.item, [], id);
+  assert.equal(s.writes, 1);
+  assert(
+    [...s.files.keys()].some(
+      (k) => k.includes("jasminum-ai-backups") && k.endsWith(".pdf"),
+    ),
+  );
+  assert(
+    [...s.files.keys()].some(
+      (k) => k.includes("jasminum-ai-backups") && k.endsWith(".json"),
+    ),
+  );
+});
+test("sidecar写入失败恢复本次PDF及旧JSON，保留备份可恢复", async () => {
+  const s = state({ failJSON: true });
+  await assert.rejects(s.api.safeSaveOutline(s.item, [], id), /保存失败/);
+  assert.deepEqual(Array.from(s.files.get("/doc.pdf")), [1]);
+  assert.deepEqual(
+    Array.from(s.files.get("/data/storage/K/jasminum-outline.json")),
+    [2],
+  );
+});
+function taskHarness(nodes, invalid = false) {
+  let runs = 0;
+  const pdf = { numPages: 297 };
+  class Agent {
+    constructor() {
+      this.pdf = pdf;
+      this.headings = [];
+      this.sentPages = new Set();
+    }
+    async run() {
+      runs++;
+      return true;
+    }
+  }
+  const api = load(
+    "src/modules/outline/task.ts",
+    {
+      "./safeState": {
+        fileIdentity: async () => id,
+        sameFile: () => true,
+        statePath: () => "/cache",
+      },
+      "./background": { outlineJob: async () => nodes },
+      "./pdfAdapter": { adaptOutlinePDFDocument: async () => pdf },
+      "../../utils/locale": { getString: (s) => s },
+      "./outline": {
+        getOutlineFromPDF: async () => nodes,
+        getOutlineFromPage: () => [],
+        saveOutlineToJSON: async () => {},
+      },
+      "./recognitionAgent": {
+        OutlineRecognitionAgent: Agent,
+        headingTree: () => [],
+      },
+    },
+    {
+      IOUtils: {},
+      addon: { data: { progress: { updateTaskStatus() {} } } },
+      Zotero: { Reader: { _readers: [] } },
+    },
+  );
+  const task = new api.OutlineTask({
+    id: 5,
+    deleted: false,
+    isPDFAttachment: () => true,
+    isEditable: () => true,
+    getFilePathAsync: async () => "/book.pdf",
+  });
+  return {
+    task,
+    get runs() {
+      return runs;
+    },
+  };
+}
+test("重复运行已有有效大纲：保留全部数据且不创建AI请求", async () => {
+  const h = taskHarness([
+    { title: "Existing", page: 15, level: 1, x: 0, y: 700, children: [] },
+  ]);
+  await h.task.run();
+  assert(h.task.keptExisting);
+  assert(h.task.applied);
+  assert.equal(h.runs, 0);
+});
+test("已有无效大纲：失败重试也不得覆盖或调用AI", async () => {
+  const h = taskHarness([
+    { title: "Broken", page: 999, level: 1, x: 0, y: 0, children: [] },
+  ]);
+  await h.task.run();
+  assert.equal(h.task.status, "fail");
+  h.task.prepareRetry();
+  await h.task.run();
+  assert.equal(h.runs, 0);
+  assert.equal(h.task.status, "fail");
+});
