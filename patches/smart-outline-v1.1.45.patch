+test("重复运行已有有效大纲：保留全部数据且不创建AI请求", async () => {
+  const h = taskHarness([
+    { title: "Existing", page: 15, level: 1, x: 0, y: 700, children: [] },
+  ]);
+  await h.task.run();
+  assert(h.task.keptExisting);
+  assert(h.task.applied);
+  assert.equal(h.runs, 0);
+});
+test("已有无效大纲：失败重试也不得覆盖或调用AI", async () => {
+  const h = taskHarness([
+    { title: "Broken", page: 999, level: 1, x: 0, y: 0, children: [] },
+  ]);
+  await h.task.run();
+  assert.equal(h.task.status, "fail");
+  h.task.prepareRetry();
+  await h.task.run();
+  assert.equal(h.runs, 0);
+  assert.equal(h.task.status, "fail");
+});
