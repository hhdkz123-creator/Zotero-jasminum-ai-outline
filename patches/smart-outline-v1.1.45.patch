+          ...new Set(entries.map((e) => Math.round(e.x / 8) * 8)),
+        ].sort((a, b) => a - b);
+        if (indents.length > 7) return null;
+        for (const e of entries)
+          if (!e.level) e.level = indents.indexOf(Math.round(e.x / 8) * 8) + 1;
+        return {
+          entries: entries.map(({ x, ...e }) => e),
+          endPage: end,
+          startPage: start,
+        };
