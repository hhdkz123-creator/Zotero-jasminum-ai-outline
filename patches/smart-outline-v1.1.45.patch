--- /dev/null
+++ b/test/smart/helpers.cjs
@@ -0,0 +1,44 @@
+const { test } = require("node:test");
+const assert = require("node:assert/strict");
+const fs = require("node:fs");
+const path = require("node:path");
+const vm = require("node:vm");
+const ts = require("typescript");
+function load(file, mocks = {}, globals = {}, cache = new Map()) {
+  file = path.resolve(file);
+  if (cache.has(file)) return cache.get(file);
+  const exports = {};
+  cache.set(file, exports);
+  vm.runInNewContext(
+    ts.transpileModule(fs.readFileSync(file, "utf8"), {
+      compilerOptions: {
+        module: ts.ModuleKind.CommonJS,
+        target: ts.ScriptTarget.ES2022,
+      },
+    }).outputText,
+    {
+      exports,
+      require: (n) =>
+        mocks[n] ??
+        (n.endsWith(".json")
+          ? require(path.resolve(path.dirname(file), n))
+          : load(
+              path.resolve(path.dirname(file), n + ".ts"),
+              mocks,
+              globals,
+              cache,
+            )),
+      Error,
+      console,
+      AbortController,
+      Uint8Array,
+      setTimeout,
+      clearTimeout,
+      Zotero: { getMainWindow: () => ({ AbortController }) },
+      ...globals,
+    },
+  );
+  return exports;
+}
+
+module.exports = { load };
diff --git a/test/smart/outline.test.cjs b/test/smart/outline.test.cjs
new file mode 100644
index 0000000..902e663
--- /dev/null
+++ b/test/smart/outline.test.cjs
@@ -0,0 +1,340 @@
+const { test } = require("node:test");
+const assert = require("node:assert/strict");
+const fs = require("node:fs");
+const path = require("node:path");
+const vm = require("node:vm");
+const ts = require("typescript");
+function load(file, mocks = {}, globals = {}, cache = new Map()) {
+  file = path.resolve(file);
+  if (cache.has(file)) return cache.get(file);
+  const exports = {};
+  cache.set(file, exports);
+  vm.runInNewContext(
+    ts.transpileModule(fs.readFileSync(file, "utf8"), {
+      compilerOptions: {
+        module: ts.ModuleKind.CommonJS,
+        target: ts.ScriptTarget.ES2022,
+      },
+    }).outputText,
+    {
+      exports,
+      require: (n) =>
+        mocks[n] ??
+        (n.endsWith(".json")
+          ? require(path.resolve(path.dirname(file), n))
+          : load(
+              path.resolve(path.dirname(file), n + ".ts"),
+              mocks,
+              globals,
+              cache,
+            )),
+      Error,
+      console,
+      AbortController,
+      Uint8Array,
+      setTimeout,
+      clearTimeout,
+      Zotero: { getMainWindow: () => ({ AbortController }) },
+      ...globals,
+    },
+  );
+  return exports;
+}
+const entries = [
+  { title: "第一章 理论基础", level: 1, pageLabel: "1", page: 15 },
+  { title: "第一节 研究方法", level: 2, pageLabel: "2", page: 16 },
+  { title: "一、核心概念", level: 3, pageLabel: "3", page: 17 },
+  { title: "第二章 历史分析", level: 1, pageLabel: "130", page: 144 },
+  { title: "第一节 材料分析", level: 2, pageLabel: "131", page: 145 },
+  { title: "一、史料说明", level: 3, pageLabel: "132", page: 146 },
+  { title: "第三章 结论", level: 1, pageLabel: "280", page: 294 },
+];
+const viewport = {
+  width: 600,
+  height: 800,
+  convertToPdfPoint: (x, y) => [x, 800 - y],
+};
+const item = (str, x = 40, y = 700) => ({ str, transform: [1, 0, 0, 0, x, y] });
+function harness({
+  mode = "smart",
+  limit = 100,
+  local = false,
+  noTOC = false,
+  entries: rows = entries,
+  failAt = 0,
+  corruptSample = false,
+  numPages = 297,
+} = {}) {
+  const calls = [];
+  let fail = failAt,
+    agent,
+    cache;
+  const pdf = {
+    numPages,
+    getPage: async (p) => ({
+      getViewport: () => viewport,
+      getTextContent: async () => ({
+        items: !local
+          ? []
+          : p === 3 && !noTOC
+            ? [
+                item("目录", 40, 760),
+                ...rows.map((e, i) =>
+                  item(
+                    e.title + " …… " + e.pageLabel,
+                    40 + (e.level - 1) * 20,
+                    730 - i * 24,
+                  ),
+                ),
+              ]
+            : rows.filter((e) => e.page === p).map((e) => item(e.title)),
+      }),
+    }),
+  };
+  const mocks = {
+    "../../utils/prefs": {
+      getPref: (k) => (k === "outlineRecognitionMode" ? mode : limit),
+    },
+    "../../utils/llm": {
+      getConfiguredLLMClient: () => ({
+        createJSONCompletion: async (options) => {
+          const pages = Array.from(
+            options.responseFormat.schema.properties.pages.items.properties.page
+              .enum,
+          );
+          assert(pages.length <= 5);
+          calls.push(pages);
+          if (calls.length === fail) {
+            fail = 0;
+            throw Error("network interruption");
+          }
+          options.onUsage?.({
+            prompt_tokens: 10,
+            completion_tokens: 2,
+            total_tokens: 12,
+          });
+          return {
+            pages: pages.map((p) => ({
+              page: p,
+              headings:
+                p === 3 && !noTOC
+                  ? []
+                  : rows
+                      .filter((e) => e.page === p)
+                      .map((e) => ({
+                        title: e.title,
+                        level: e.level,
+                        left: 0.1,
+                        top: 0.1,
+                      })),
+              ...(options.responseFormat.name === "contents_outline"
+                ? {
+                    pageLabel:
+                      corruptSample && p === 294
+                        ? "279"
+                        : p >= 15
+                          ? String(p - 14)
+                          : null,
+                    contents:
+                      p === 3 && !noTOC
+                        ? {
+                            starts: true,
+                            continues: false,
+                            entries: rows.map(({ page, ...e }) => e),
+                          }
+                        : null,
+                  }
+                : {}),
+            })),
+          };
+        },
+      }),
+    },
+    "../../utils/pdfImage": {
+      renderPDFPagesAsPNG: async (id, pages) =>
+        pages.map((pageIndex) => ({
+          pageIndex,
+          data: new Uint8Array([1]),
+          mimeType: "image/png",
+        })),
+    },
+  };
+  const api = load("src/modules/outline/recognitionAgent.ts", mocks);
+  agent = new api.OutlineRecognitionAgent(7, pdf);
+  agent.checkpoint = async () => {
+    cache = JSON.parse(JSON.stringify(agent.exportCache()));
+  };
+  return {
+    agent,
+    calls,
+    pdf,
+    api,
+    get cache() {
+      return cache;
+    },
+    run: () => agent.run(() => {}),
+    mocks,
+  };
+}
+test("297页：完整本地多级目录零AI，所有目的地精确且保留章节目", async () => {
+  const h = harness({ local: true });
+  assert.equal(await h.run(), true);
+  assert.equal(h.calls.length, 0);
+  assert(h.agent.usedContents);
+  assert.equal(h.agent.headings.length, 7);
+  assert.deepEqual(
+    Array.from(h.agent.headings, (h) => h.page),
+    entries.map((e) => e.page),
+  );
+  assert.equal(h.agent.headings[2].level, 3);
+  assert(h.agent.headings.every((h) => h.exact));
+});
+test("297页扫描版：目录+校准+抽样提前结束，重复运行无调用", async () => {
+  const h = harness();
+  assert.equal(await h.run(), true);
+  assert(h.agent.usedContents);
+  assert(h.calls.length <= 6);
+  assert(h.agent.imagePages < 25);
+  const before = h.calls.length;
+  await h.run();
+  assert.equal(h.calls.length, before);
+  assert.deepEqual(
+    Array.from(h.agent.headings, (h) => h.page),
+    entries.map((e) => e.page),
+  );
+});
+test("无目录：缓存的前30页复用于全文，总计60请求297图片", async () => {
+  const h = harness({ noTOC: true });
+  assert.equal(await h.run(), true);
+  assert(!h.agent.usedContents);
+  assert.equal(h.calls.length, 60);
+  assert.equal(h.agent.imagePages, 297);
+  assert.equal(new Set(h.calls.flat()).size, 297);
+  assert.equal(h.agent.tokens.total_tokens, 720);
+});
+test("完整模式忽略目录捷径并识别全部297页", async () => {
+  const h = harness({ mode: "full" });
+  assert.equal(await h.run(), true);
+  assert.equal(h.calls.length, 60);
+  assert.equal(h.agent.stage, "full");
+  assert(!h.agent.usedContents);
+});
+test("上限暂停后显式增加额度；成功页不重发", async () => {
+  const h = harness({ mode: "full", limit: 2 });
+  assert.equal(await h.run(), false);
+  assert(h.agent.quotaPaused);
+  assert.equal(h.calls.length, 2);
+  assert.equal(await h.run(), false);
+  assert.equal(h.calls.length, 2);
+  h.agent.continueBudget();
+  await h.run();
+  assert.equal(h.calls.length, 4);
+  assert.equal(new Set(h.calls.flat()).size, 20);
+});
+test("网络中断恢复不重复成功页；失败请求和图片也计入统计", async () => {
+  const h = harness({ mode: "full", failAt: 2, numPages: 17 });
+  await assert.rejects(h.run(), /network/);
+  assert.equal(h.agent.requests, 2);
