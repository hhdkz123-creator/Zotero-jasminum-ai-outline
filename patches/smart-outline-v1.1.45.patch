+      previous = pages[0];
+      const page = await this.pdf.getPage(previous);
+      result.push(
+        locateHeading(
+          { ...entry, left: 0, top: 0 },
+          previous,
+          page,
+          await this.read(previous),
+        ),
+      );
+    }
+    return result;
+  }
+}
