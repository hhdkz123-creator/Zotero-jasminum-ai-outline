+const { test } = require("node:test");
+const assert = require("node:assert/strict");
+const { load } = require("./helpers.cjs");
+function setup(enabled = true) {
+  const hooks = [],
+    calls = [];
+  let resolve;
+  const waiting = new Promise((r) => (resolve = r));
+  const reader = { tabID: "restored-pdf", _initPromise: waiting };
+  const api = load(
+    "src/modules/notifier.ts",
+    {
+      "../../package.json": { config: { addonID: "jasminum@linxzh.com" } },
+      "../utils/locale": {},
+      "../utils/prefs": { getPref: () => enabled },
+      "../utils/detect": {},
+      "./outline": { registerOutline: async (id) => calls.push(id) },
+      "./outline/selection": {
+        onSelectionPopup() {},
+        onSelectionContextMenu() {},
+      },
+      "./tools": {},
+    },
+    {
+      Zotero: {
+        Reader: {
+          _readers: [reader],
+          registerEventListener: (type, handler) =>
+            hooks.push({ type, handler }),
+        },
+      },
+      ztoolkit: { log() {} },
+    },
+  );
+  return { api, reader, hooks, calls, resolve };
+}
+test("启动时补初始化已恢复的PDF，同时保留正常工具栏事件入口", async () => {
+  const h = setup();
+  h.api.registerTab();
+  assert.equal(h.calls.length, 0);
+  h.resolve();
+  await new Promise(setImmediate);
+  assert.deepEqual(h.calls, ["restored-pdf"]);
+  await h.hooks
+    .find((h) => h.type === "renderToolbar")
+    .handler({ reader: { tabID: "new-pdf" } });
+  assert.deepEqual(h.calls, ["restored-pdf", "new-pdf"]);
+});
+test("已关闭的大纲功能不会被启动补初始化重新打开", async () => {
+  const h = setup(false);
+  h.api.registerTab();
+  h.resolve();
+  await new Promise(setImmediate);
+  assert.equal(h.calls.length, 0);
+});
