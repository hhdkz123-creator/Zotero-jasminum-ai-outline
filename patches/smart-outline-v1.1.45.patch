diff --git a/src/modules/outline/safeState.ts b/src/modules/outline/safeState.ts
new file mode 100644
index 0000000..85c2bf3
--- /dev/null
+++ b/src/modules/outline/safeState.ts
@@ -0,0 +1,80 @@
+import { writePDFOutline } from "./savePDF";
+import { saveOutlineToJSON } from "./outline";
+
+export async function fileIdentity(path: string) {
+  const before = await IOUtils.stat(path);
+  const digest = await Zotero.Utilities.Internal.md5Async(path);
+  const after = await IOUtils.stat(path);
+  if (before.size !== after.size || before.lastModified !== after.lastModified)
+    throw new Error("PDF 正在被其他进程修改，请稍后重试。");
+  if (typeof after.size !== "number" || typeof after.lastModified !== "number")
+    throw new Error("PDF 文件状态不可用");
+  return { size: after.size, modified: after.lastModified, digest };
+}
+export type FileIdentity = Awaited<ReturnType<typeof fileIdentity>>;
+export const sameFile = (a: FileIdentity, b: FileIdentity) =>
+  a.size === b.size && a.modified === b.modified && a.digest === b.digest;
+export function statePath(item: Zotero.Item) {
+  return PathUtils.join(
+    Zotero.DataDirectory.dir,
+    "storage",
+    item.key,
+    "jasminum-ai-cache.json",
+  );
+}
+
+/** Backups never replace previous generations. Roll back only our own PDF bytes. */
+export async function safeSaveOutline(
+  item: Zotero.Item,
+  nodes: OutlineNode[],
+  expected: FileIdentity,
+) {
+  const path = await item.getFilePathAsync();
+  if (!path || !sameFile(expected, await fileIdentity(path)))
+    throw new Error(
+      "PDF 自识别开始后已改变，停止保存；请重新打开文献后再识别。",
+    );
+  const dir = PathUtils.join(PathUtils.parent(path)!, "jasminum-ai-backups");
+  await IOUtils.makeDirectory(dir, { ignoreExisting: true });
+  const id = `${Date.now()}-${Zotero.Utilities.randomString()}`;
+  const backup = PathUtils.join(dir, `${id}.pdf`);
+  const sidecar = PathUtils.join(
+    Zotero.DataDirectory.dir,
+    "storage",
+    item.key,
+    "jasminum-outline.json",
+  );
+  const jsonBackup = PathUtils.join(dir, `${id}.json`);
+  await IOUtils.copy(path, backup, { noOverwrite: true });
+  const hadJSON = await IOUtils.exists(sidecar);
+  if (hadJSON) await IOUtils.copy(sidecar, jsonBackup, { noOverwrite: true });
+  if (!sameFile(expected, await fileIdentity(path)))
+    throw new Error("备份期间 PDF 已改变，停止保存。");
+  let written: FileIdentity | undefined;
+  try {
+    await writePDFOutline(item, nodes, {
+      size: expected.size,
+      modified: expected.modified,
+    });
+    written = await fileIdentity(path);
+    await saveOutlineToJSON(item, nodes);
+    return written;
+  } catch (error) {
+    if (written && sameFile(written, await fileIdentity(path))) {
+      await IOUtils.write(path, await IOUtils.read(backup), {
+        tmpPath: `${path}.jasminum-restore.tmp`,
+      });
+      if (hadJSON)
+        await IOUtils.write(sidecar, await IOUtils.read(jsonBackup), {
+          tmpPath: `${sidecar}.restore.tmp`,
+        });
+      else await IOUtils.remove(sidecar, { ignoreAbsent: true });
+    }
+    throw new Error(
+      `大纲保存失败：${error instanceof Error ? error.message : "文件写入错误"}。原件备份保留在 ${backup}。请重试保存。`,
+      {
+        cause: error,
+      },
+    );
+  }
+}
