diff --git a/src/modules/outline/auto.ts b/src/modules/outline/auto.ts
new file mode 100644
index 0000000..d7d4e17
--- /dev/null
+++ b/src/modules/outline/auto.ts
@@ -0,0 +1,36 @@
+import { outlineJob } from "./background";
+import { getPref } from "../../utils/prefs";
+
+// Includes in-flight checks and paused/failed attempts, so reopening a document
+// cannot repeatedly start AI work. Manual retry remains available on the toolbar.
+const checkedItems = new Set<number>();
+
+export async function autoRecognizeOutline(
+  reader: _ZoteroTypes.ReaderInstance,
+  doc: Document,
+) {
+  if (!getPref("autoRecognizeOutline")) return "disabled";
+  const item = reader._item;
+  if (checkedItems.has(item.id)) return "already-checked";
+  if (item.deleted || !item.isPDFAttachment() || !item.isEditable())
+    return "unavailable";
+  checkedItems.add(item.id);
+  try {
+    const path = await item.getFilePathAsync();
+    if (!path) return "unavailable";
+    // Read the PDF itself: the sidecar cache may be empty or out of date.
+    const nativeOutline = await outlineJob<OutlineNode[]>("nativeOutline", path);
+    if (nativeOutline.length) return "has-native-outline";
+    if (!getPref("autoRecognizeOutline")) return "disabled";
+    const button = doc.getElementById("j-outline-ai") as HTMLButtonElement | null;
+    if (!button?.isConnected) return "closed";
+    if (button.disabled) return "busy";
+    // The normal toolbar handler owns progress, pause, deduplication, PDF save
+    // and reader refresh. Automatic recognition uses that exact same path.
+    button.click();
+    return "started";
+  } catch (error) {
+    ztoolkit.log("Automatic PDF outline check failed", error);
+    return "failed";
+  }
+}
