diff --git a/src/modules/outline/localTOC.ts b/src/modules/outline/localTOC.ts
new file mode 100644
index 0000000..337c56f
--- /dev/null
+++ b/src/modules/outline/localTOC.ts
@@ -0,0 +1,188 @@
+import {
+  compact,
+  locateHeading,
+  type LocatedHeading,
+  type OutlinePDFDocument,
+  type TextItem,
+} from "./heading";
+import type { ContentsCandidate, ContentsEntry } from "./tocAgent";
+
+/** Geometry is retained in memory only; no body text or images are persisted. */
+export class LocalOutlineReader {
+  readonly pages = new Map<number, Promise<TextItem[]>>();
+  constructor(
+    private pdf: OutlinePDFDocument,
+    private check: () => void,
+  ) {}
+  read(page: number) {
+    this.check();
+    if (!this.pages.has(page))
+      this.pages.set(
+        page,
+        this.pdf
+          .getPage(page)
+          .then((p) => p.getTextContent())
+          .then((c) =>
+            c.items.filter(
+              (i): i is TextItem =>
+                "str" in i &&
+                i.transform.length === 6 &&
+                i.transform.every(Number.isFinite),
+            ),
+          ),
+      );
+    return this.pages.get(page)!;
+  }
+  async lines(page: number) {
+    const items = await this.read(page);
+    this.check();
+    const rows: { y: number; items: TextItem[] }[] = [];
+    for (const item of items) {
+      let row = rows.find((r) => Math.abs(r.y - item.transform[5]) < 2);
+      if (!row) {
+        row = { y: item.transform[5], items: [] };
+        rows.push(row);
+      }
+      row.items.push(item);
+    }
+    return rows
+      .sort((a, b) => b.y - a.y)
+      .map((r) => {
+        r.items.sort((a, b) => a.transform[4] - b.transform[4]);
+        return {
+          text: r.items
+            .map((i) => i.str)
+            .join(" ")
+            .normalize("NFKC")
+            .trim(),
+          x: r.items[0].transform[4],
+        };
+      });
+  }
+  async contents(limit: number): Promise<ContentsCandidate | null> {
+    let start = 0,
+      end = 0,
+      uncertain = false;
+    const entries: (ContentsEntry & { x: number })[] = [];
+    for (let p = 1; p <= Math.min(limit, this.pdf.numPages); p++) {
