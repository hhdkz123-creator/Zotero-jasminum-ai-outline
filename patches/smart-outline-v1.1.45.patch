+    return null;
+  }
+  async resolve(
+    candidate: ContentsCandidate,
+  ): Promise<LocatedHeading[] | null> {
+    // Match complete lines rather than mentions in body paragraphs or TOC rows.
+    // Direct destinations handle Roman matter, numbering resets and local shifts.
+    const samples = [
+      candidate.endPage + 1,
+      Math.ceil(this.pdf.numPages / 2),
+      this.pdf.numPages,
+    ].filter((p) => p <= this.pdf.numPages);
+    if (
+      (await Promise.all(samples.map((p) => this.read(p)))).every(
+        (items) => items.length === 0,
+      ) &&
+      (await Promise.all(this.pages.values())).every(
+        (items) => items.length === 0,
+      )
+    )
+      return null;
+    const targets = new Set(candidate.entries.map((e) => compact(e.title)));
+    const matches = new Map<string, number[]>();
+    for (let p = 1; p <= this.pdf.numPages; p++) {
+      if (p >= (candidate.startPage ?? 1) && p <= candidate.endPage) continue;
+      for (const line of await this.lines(p)) {
+        const key = compact(line.text);
+        if (targets.has(key)) {
+          const found = matches.get(key) ?? [];
+          if (!found.includes(p)) found.push(p);
+          matches.set(key, found);
+        }
+      }
+    }
+    const result: LocatedHeading[] = [];
+    let previous = 0;
+    for (const entry of candidate.entries) {
+      const pages = matches.get(compact(entry.title)) ?? [];
