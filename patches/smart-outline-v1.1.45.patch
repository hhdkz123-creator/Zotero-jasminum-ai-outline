+  const files = new Map([
+    ["/doc.pdf", new Uint8Array([1])],
+    ["/data/storage/K/jasminum-outline.json", new Uint8Array([2])],
+  ]);
+  let current = { ...id },
+    writes = 0,
+    statCalls = 0;
+  const io = {
+    stat: async () => {
+      statCalls++;
+      return { size: current.size, lastModified: current.modified };
+    },
+    exists: async (p) => files.has(p),
+    makeDirectory: async () => {},
+    copy: async (a, b) => {
+      assert(!files.has(b));
+      files.set(b, files.get(a));
+    },
+    read: async (p) => files.get(p),
+    write: async (p, bytes) => {
+      files.set(p, bytes);
+      current = { ...id, modified: 3 };
+    },
+    remove: async (p) => files.delete(p),
+  };
+  const api = load(
+    "src/modules/outline/safeState.ts",
+    {
+      "./savePDF": {
+        writePDFOutline: async (item, nodes, expected) => {
+          assert.equal(expected.modified, 1);
+          writes++;
+          current = { size: 12, modified: 2, digest: "new" };
+          files.set("/doc.pdf", new Uint8Array([3]));
+        },
+      },
+      "./outline": {
+        saveOutlineToJSON: async () => {
+          if (failJSON) throw Error("disk full");
+        },
+      },
+    },
+    {
+      IOUtils: io,
+      PathUtils: {
+        join: (...s) => s.join("/").replace(/\/+/g, "/"),
+        parent: (p) => p.slice(0, p.lastIndexOf("/")),
+      },
+      Zotero: {
+        DataDirectory: { dir: "/data" },
+        Utilities: {
+          randomString: () => String(statCalls),
+          Internal: { md5Async: async () => current.digest },
+        },
+      },
+    },
+  );
+  return {
+    api,
+    files,
+    get writes() {
+      return writes;
+    },
+    item: { key: "K", getFilePathAsync: async () => "/doc.pdf" },
+    change: () => (current = { ...id, digest: "external" }),
+  };
+}
